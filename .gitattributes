# Źródło VBA musi być czytelne dla importu w MicroStation na Windows.
*.bas text eol=crlf

# Dokumentacja pozostaje LF dla czystych diffów.
*.md text eol=lf
LICENSE text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# Binarne projekty VBA nie mogą być konwertowane przez linie.
*.mvba -text
